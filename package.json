{
  "name": "dough-calculator",
  "type": "module",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "serve .output/public --single --listen tcp://localhost:4173 --no-clipboard --no-port-switching",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vite-pwa/nuxt": "^1.1.1",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "serve": "14.2.6",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
